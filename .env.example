NODE_ENV=production
PORT=10000

# PUBLIC_CONFIG — safe to expose to the browser as non-secret network metadata
MIDNIGHT_NETWORK=preprod
# Blockfrost operates the official Preprod indexer/RPC (old midnight.network
# Preprod hosts are shut down). Every call needs ?project_id=<token>.
MIDNIGHT_INDEXER_URL=https://midnight-preprod.blockfrost.io/api/v0
MIDNIGHT_INDEXER_WS_URL=wss://midnight-preprod.blockfrost.io/api/v0/ws
MIDNIGHT_NODE_URL=https://rpc.midnight-preprod.blockfrost.io
# REQUIRED for any indexer/RPC call. Create a Midnight Preprod project at
# blockfrost.io and paste the token here. Never commit a real token.
BLOCKFROST_PROJECT_ID=
COHORT_CONTRACT_ADDRESS=1d5c2084222c8abea80bc8228c0c743ca183138e52f404594caa28572e7c29cc
PUBLIC_APP_URL=http://127.0.0.1:10000
CORS_ORIGIN=http://127.0.0.1:10000

# SERVER_SECRET — never VITE_*, never frontend, never render.yaml values
# GITHUB_TOKEN=
# RENDER_API_KEY=
# VERCEL_API_TOKEN=

# WALLET_SECRET — local/testnet deploy only, never frontend
# MIDNIGHT_PREPROD_SEED=
