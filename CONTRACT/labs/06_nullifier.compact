pragma language_version 0.23;
import CompactStandardLibrary;

export ledger spent: Set<Bytes<32>>;

witness secretKey(): Bytes<32>;

circuit nullifier(trialId: Bytes<32>, sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "cohort:ref"), trialId, sk]);
}

export circuit act(trialId: Bytes<32>): [] {
  const nul = nullifier(trialId, secretKey());
  assert(!spent.member(disclose(nul)), "already acted this trial");
  spent.insert(disclose(nul));
}
