pragma language_version 0.23;
import CompactStandardLibrary;

witness wAge(): Uint<8>;
witness wSex(): Uint<8>;
witness wCondition(): Boolean;
witness wMedication(): Boolean;
witness wSecret(): Bytes<32>;
witness wBlind(): Bytes<32>;

export ledger spent: Set<Bytes<32>>;
export ledger referrals: Set<Bytes<32>>;
export ledger proven: Counter;

circuit trialNullifier(trialId: Bytes<32>, sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "cohort:ref"),
    trialId,
    sk
  ]);
}

export circuit proveEligible(
  trialId: Bytes<32>,
  minAge: Uint<8>,
  maxAge: Uint<8>,
  requireCondition: Boolean,
  forbidMedication: Boolean
): Boolean {
  const age = wAge();
  const cond = wCondition();
  const med = wMedication();
  assert(age >= minAge, "too young");
  assert(age <= maxAge, "too old");
  if (requireCondition) {
    assert(cond, "missing condition");
  }
  if (forbidMedication) {
    assert(!med, "medication excluded");
  }
  const nul = trialNullifier(trialId, wSecret());
  assert(!spent.member(disclose(nul)), "already proven this trial");
  spent.insert(disclose(nul));
  const referral = persistentCommit<Bytes<32>>(wSecret(), wBlind());
  referrals.insert(disclose(referral));
  proven.increment(1);
  return true;
}
